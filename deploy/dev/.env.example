# Copy to .env and replace all CHANGE_ME values with locally generated secrets.
# This file is only for an isolated development machine.
DE_DEV_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
DE_DEV_MYSQL_PASSWORD=CHANGE_ME_APP
DE_DEV_REDIS_PASSWORD=CHANGE_ME_REDIS
DE_DEV_ADMIN_PASSWORD=CHANGE_ME_ADMIN
DE_DEV_SUBSTITULE_PATH=CHANGE_ME_ABSOLUTE_WRITABLE_PATH
DE_DEV_MYSQL_PORT=3306
DE_DEV_REDIS_PORT=6379
